{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/warta/(.*)",
      "destination": "/api/post?slug=$1"
    },
    {
      "source": "/post/(.*)",
      "destination": "/api/post?slug=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
