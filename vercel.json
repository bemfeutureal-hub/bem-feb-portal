{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "post"
        }
      ],
      "destination": "/api/share"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "slug"
        }
      ],
      "destination": "/api/share"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
